    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "0a696009-c1c3-5d8f-81a0-f3db9fc0327d",
              "leftValue": "={{ String($json.data_nascimento ?? '').split('/').slice(0, 2).map(p => p.trim().padStart(2, '0')).join('/') }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $now.plus({ days: 1 }).toFormat('dd/MM') }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ef1bdf59-3cb6-5bbe-bfe8-10eaf9dad954",
      "name": "Aniversário amanhã?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        480,
        340
      ]
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "645bc72b-6006-52c5-b87d-c9bec3eacf4e",
              "name": "linha",
              "value": "={{ (() => {\n  const partes = String($json.data_nascimento).split('/');\n  const ano = parseInt(partes[2]);\n  const idade = ano > 1900 ? ` faz ${$now.plus({ days: 1 }).year - ano} anos` : ' faz aniversário';\n  const nome = String($json.nome).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n  const obs = $json.observacao ? `\\n   📝 ${String($json.observacao).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}` : '';\n  return `🎂 <b>${nome}</b>${idade} amanhã (${partes[0].padStart(2, '0')}/${partes[1].padStart(2, '0')})${obs}`;\n})() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "36406997-abd8-5cec-9d8d-0002cbaa412a",
      "name": "Montar linha",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        340
      ]
    },
    {
      "parameters": {
        "fieldsToAggregate": {
          "fieldToAggregate": [
            {
              "fieldToAggregate": "linha"
            }
          ]
        },
        "options": {}
      },
      "id": "f923bb77-72c0-5499-82e0-5e04ad40a862",
      "name": "Juntar aniversariantes",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        960,
        340
      ]
    },
