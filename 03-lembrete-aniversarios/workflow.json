        "operation": "sendMessage",
        "chatId": "SEU_CHAT_ID",
        "text": "=🎉 <b>Aniversários de amanhã</b>\n\n{{ $json.linha.join('\\n\\n') }}\n\nNão esquece de mandar uma mensagem! 😉",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "disable_web_page_preview": true
        }
      },
