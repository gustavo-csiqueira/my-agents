      "typeVersion": 3.4,
      "position": [
        240,
        340
      ]
    },
    {
      "parameters": {
        "resource": "databasePage",
        "operation": "create",
        "databaseId": {
          "__rl": true,
          "value": "ID_DO_BANCO_NOTION",
          "mode": "id"
        },
        "title": "={{ $json.titulo }}",
        "propertiesUi": {
          "propertyValues": []
        },
        "blockUi": {
          "blockValues": [
            {
              "type": "paragraph",
              "textContent": "=De: {{ $json.remetente }}"
            },
            {
              "type": "paragraph",
              "textContent": "=Recebido em: {{ $json.recebido_em }}"
            },
            {
              "type": "paragraph",
              "textContent": "=Abrir e-mail: {{ $json.link }}"
            },
            {
              "type": "paragraph",
              "textContent": "={{ $json.trecho }}"
            }
          ]
        },
        "options": {}
      },
      "id": "469e940d-8f11-5cb0-a478-b26ab2215d4d",
