          "assignments": [
            {
              "id": "63e69f49-aefc-545f-8f67-14e113b29706",
              "name": "titulo",
              "value": "={{ $json.subject || '(sem assunto)' }}",
              "type": "string"
            },
            {
              "id": "9e4e2aaf-863b-5b74-9896-eb621d479eff",
              "name": "remetente",
              "value": "={{ $json.from?.text ?? $json.from?.value?.[0]?.address ?? '' }}",
              "type": "string"
            },
            {
              "id": "a5c4d21b-49c3-5fdd-88a5-8c592c74c165",
              "name": "link",
              "value": "=https://mail.google.com/mail/u/0/#all/{{ $json.id }}",
              "type": "string"
            },
            {
              "id": "2fcd4a8c-8033-5fc1-a811-7b043f79f764",
              "name": "recebido_em",
              "value": "={{ DateTime.fromISO($json.date).setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy HH:mm') }}",
              "type": "string"
            },
            {
              "id": "b3eab74a-dd07-53e4-8d75-f6df1713b407",
              "name": "trecho",
              "value": "={{ ($json.text ?? '').trim().slice(0, 500) }}",
              "type": "string"
            },
            {
              "id": "5ad047fc-dd36-5205-a713-ddeb2b78b079",
              "name": "message_id",
              "value": "={{ $json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "53786530-474b-5d61-a2b0-29858cde4b74",
      "name": "Preparar dados",
