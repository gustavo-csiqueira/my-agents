{
  "name": "05 - Triagem de e-mails com IA",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyX",
              "value": 2,
              "unit": "minutes"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "INBOX"
          ]
        },
        "options": {}
      },
      "id": "b14328b2-a0c4-55a1-9ad8-a9ecd3311826",
      "name": "Novo e-mail",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        400
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "credencial-gmail",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "inputText": "=Remetente: {{ $json.from?.text }}\nAssunto: {{ $json.subject }}\n\n{{ ($json.text ?? '').slice(0, 2500) }}",
        "categories": {
          "categories": [
            {
              "category": "urgente",
              "description": "Precisa da minha ação hoje: prazos curtos, problemas em produção, pedidos diretos e importantes de pessoas reais, alertas de segurança da minha conta."
            },
            {
              "category": "trabalho",
              "description": "Assuntos profissionais que não são urgentes: reuniões, projetos, colegas, clientes, recrutadores."
            },
            {
              "category": "financeiro",
              "description": "Boletos, faturas, cobranças, notas fiscais, extratos, comprovantes de pagamento, assinaturas."
            },
            {
              "category": "newsletter",
              "description": "Newsletters, promoções, marketing, notificações automáticas de serviços e redes sociais."
            },
            {
              "category": "outros",
              "description": "Qualquer coisa que não se encaixe nas categorias anteriores."
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Você faz a triagem da caixa de entrada de uma pessoa no Brasil. Classifique o e-mail em exatamente uma categoria. Na dúvida entre 'urgente' e outra, só use 'urgente' se houver ação necessária hoje. Golpes e phishing não são urgentes: classifique como 'outros'."
        }
      },
      "id": "5d754b92-9034-5997-b642-02b9bd769bde",
      "name": "Classificar e-mail",
      "type": "@n8n/n8n-nodes-langchain.textClassifier",
      "typeVersion": 1.1,
      "position": [
        260,
        400
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-haiku-5-5",
          "mode": "id"
        },
        "options": {}
      },
      "id": "7a222632-2d72-5831-9cd2-8a315454fe57",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
