    {
      "parameters": {
        "jsCode": "// Extrai descrição e valor de mensagens como \"mercado 85,90\" ou \"uber 1.234,50\"\n// e define a categoria por palavras-chave. Edite CATEGORIAS à vontade.\nconst CATEGORIAS = {\n  'Alimentação': ['mercado', 'supermercado', 'padaria', 'restaurante', 'lanche', 'ifood', 'almoço', 'almoco', 'jantar', 'café', 'cafe', 'pizza'],\n  'Transporte': ['uber', '99', 'gasolina', 'combustível', 'combustivel', 'ônibus', 'onibus', 'metrô', 'metro', 'estacionamento', 'pedágio', 'pedagio'],\n  'Moradia': ['aluguel', 'condomínio', 'condominio', 'luz', 'energia', 'água', 'agua', 'internet', 'gás', 'gas'],\n  'Saúde': ['farmácia', 'farmacia', 'remédio', 'remedio', 'médico', 'medico', 'dentista', 'academia', 'exame'],\n  'Lazer': ['cinema', 'show', 'bar', 'netflix', 'spotify', 'viagem', 'jogo', 'livro'],\n  'Compras': ['roupa', 'sapato', 'amazon', 'shopee', 'mercado livre', 'presente'],\n};\n\nreturn $input.all().map((item) => {\n  const texto = item.json.message.text.trim();\n  const m = texto.match(/^(.+?)\\s+(?:r\\$\\s*)?(\\d[\\d.,]*)$/i);\n  const descricao = m[1].trim();\n  let bruto = m[2];\n  // \"1.234,56\" -> 1234.56 | \"85,90\" -> 85.90 | \"85.90\" -> 85.90\n  if (bruto.includes(',')) bruto = bruto.replace(/\\./g, '').replace(',', '.');\n  const valor = Math.round(parseFloat(bruto) * 100) / 100;\n\n  const d = descricao.toLowerCase();\n  const categoria = Object.entries(CATEGORIAS)\n    .find(([, palavras]) => palavras.some((p) => d.includes(p)))?.[0] ?? 'Outros';\n\n  return {\n    json: {\n      data: DateTime.now().setZone('America/Sao_Paulo').toFormat('dd/MM/yyyy'),\n      descricao,\n      categoria,\n      valor,\n      chat_id: item.json.message.chat.id,\n    },\n  };\n});\n"
      },
