    {
      "parameters": {
        "jsCode": "// Soma os gastos do mês atual por categoria\nconst agora = DateTime.now().setZone('America/Sao_Paulo').setLocale('pt-BR');\nconst sufixo = agora.toFormat('MM/yyyy'); // datas gravadas como dd/MM/yyyy\n\nconst porCategoria = {};\nlet total = 0;\nfor (const { json: l } of $input.all()) {\n  if (!l.data || !String(l.data).endsWith(sufixo)) continue;\n  const valor = typeof l.valor === 'number' ? l.valor : parseFloat(String(l.valor).replace(',', '.'));\n  if (isNaN(valor)) continue;\n  const cat = l.categoria || 'Outros';\n  porCategoria[cat] = (porCategoria[cat] ?? 0) + valor;\n  total += valor;\n}\n\nconst brl = (v) => 'R$ ' + v.toFixed(2).replace('.', ',').replace(/\\B(?=(\\d{3})+(?!\\d))/g, '.');\nconst linhas = [`📊 <b>Gastos de ${agora.toFormat('LLLL/yyyy')}</b>`, ''];\nconst ordenado = Object.entries(porCategoria).sort((a, b) => b[1] - a[1]);\nif (ordenado.length === 0) linhas.push('Nenhum gasto registrado neste mês ainda.');\nfor (const [cat, v] of ordenado) {\n  const pct = total ? Math.round((v / total) * 100) : 0;\n  linhas.push(`• ${cat}: ${brl(v)} (${pct}%)`);\n}\nif (ordenado.length) linhas.push('', `💰 <b>Total: ${brl(total)}</b>`);\n\nreturn [{ json: { mensagem: linhas.join('\\n') } }];\n"
      },
