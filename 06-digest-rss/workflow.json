    {
      "parameters": {
        "jsCode": "// Monta o digest em HTML (e-mail) e numa versão curta (Telegram), agrupado por tema.\nconst cfg = $('Configuração').first().json;\nconst artigos = $input.all().map((i) => i.json);\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n\n// Feeds que falharam (vêm do nó \"Normalizar itens\" com o campo erro preenchido)\nlet falhas = [];\ntry {\n  const vistos = new Set();\n  falhas = $('Normalizar itens').all().map((i) => i.json)\n    .filter((j) => j.erro && !vistos.has(j.fonte) && vistos.add(j.fonte));\n} catch (e) { falhas = []; }\n\n// Agrupa por tema respeitando a ordem da lista de temas\nconst grupos = {};\nfor (const a of artigos) (grupos[a.tema] ??= []).push(a);\nconst ordem = [...cfg.temas, ...Object.keys(grupos)].filter((t, i, arr) => grupos[t] && arr.indexOf(t) === i);\n\nconst hoje = DateTime.now().setZone('America/Sao_Paulo').setLocale('pt-BR');\nconst inicio = hoje.minus({ days: cfg.dias });\nconst periodo = `${inicio.toFormat(\"dd 'de' LLL\")} a ${hoje.toFormat(\"dd 'de' LLL\")}`;\nconst dataCurta = (d) => { const dt = DateTime.fromISO(d); return dt.isValid ? dt.setZone('America/Sao_Paulo').toFormat('dd/MM') : ''; };\n\n// ---------- HTML ----------\nconst cor = '#2f6f4f';\nlet html = `<!doctype html><html><body style=\"margin:0;background:#f4f4f1;font-family:Georgia,'Times New Roman',serif;color:#1f1f1f;\">\n<div style=\"max-width:640px;margin:0 auto;padding:32px 20px;\">\n  <p style=\"margin:0;font:12px/1.4 Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#777;\">Digest semanal · ${esc(periodo)}</p>\n  <h1 style=\"margin:6px 0 4px;font-size:28px;\">Leituras da semana</h1>\n  <p style=\"margin:0 0 24px;font:14px/1.5 Arial,sans-serif;color:#555;\">${artigos.length} artigos de ${new Set(artigos.map((a) => a.fonte)).size} fontes, em ${ordem.length} temas.</p>`;\n\nfor (const tema of ordem) {\n  html += `<h2 style=\"margin:32px 0 12px;padding-bottom:6px;border-bottom:2px solid ${cor};font-size:20px;color:${cor};\">${esc(tema)} <span style=\"font:13px Arial,sans-serif;color:#888;\">(${grupos[tema].length})</span></h2>`;\n  for (const a of grupos[tema]) {\n    html += `<div style=\"margin:0 0 20px;\">\n      <a href=\"${esc(a.link)}\" style=\"font-size:17px;font-weight:bold;color:#1f1f1f;text-decoration:none;\">${esc(a.titulo)}</a>\n      <p style=\"margin:4px 0 6px;font:15px/1.55 Arial,sans-serif;color:#333;\">${esc(a.resumo)}</p>\n      <p style=\"margin:0;font:12px Arial,sans-serif;color:#888;\">${esc(a.fonte)}${dataCurta(a.data) ? ' · ' + dataCurta(a.data) : ''} · <a href=\"${esc(a.link)}\" style=\"color:${cor};\">ler artigo →</a></p>\n    </div>`;\n  }\n}\nif (falhas.length) {\n  html += `<div style=\"margin-top:32px;padding:12px 16px;background:#fff6e5;border-left:4px solid #e0a100;font:13px/1.5 Arial,sans-serif;color:#6b5000;\">\n    <b>⚠️ Feeds com problema nesta semana:</b><br>${falhas.map((f) => `${esc(f.fonte)} — ${esc(f.erro).slice(0, 120)}`).join('<br>')}</div>`;\n}\nhtml += `<p style=\"margin-top:40px;font:12px Arial,sans-serif;color:#999;text-align:center;\">Gerado automaticamente com n8n · resumos feitos por IA, confira o original antes de citar.</p></div></body></html>`;\n\n// ---------- Telegram (limite de 4096 caracteres) ----------\nconst LIMITE = 3900;\nlet tg = `📰 <b>Digest semanal</b> · ${esc(periodo)}\\n${artigos.length} artigos\\n`;\nlet cortados = 0;\nfor (const tema of ordem) {\n  const bloco = `\\n<b>${esc(tema)}</b>\\n` + grupos[tema].map((a) => `• <a href=\"${esc(a.link)}\">${esc(a.titulo)}</a>`).join('\\n') + '\\n';\n  if (tg.length + bloco.length > LIMITE) { cortados += grupos[tema].length; continue; }\n  tg += bloco;\n}\nif (cortados) tg += `\\n…e mais ${cortados} no e-mail.`;\nif (falhas.length) tg += `\\n⚠️ ${falhas.length} feed(s) com erro: ${falhas.map((f) => esc(f.fonte)).join(', ')}`;\n\nreturn [{ json: {\n  assunto: `📰 Digest semanal: ${artigos.length} leituras (${periodo})`,\n  html,\n  telegram: tg,\n  email_destino: cfg.email_destino,\n  chat_id: cfg.chat_id,\n} }];\n"
      },
      "id": "05680a84-b189-51a5-a5ce-9ca3d0cb0666",
      "name": "Montar digest",
