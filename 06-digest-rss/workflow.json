      "id": "79842d58-0a85-5713-93a6-67bc74d5d38e",
      "name": "Juntar resumo e artigo",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        2340,
        400
      ]
